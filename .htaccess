RewriteEngine On

# 1. Quitar la extensión .html visiblemente con redirección 301
RewriteCond %{THE_REQUEST} /([^\s?]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Si alguien visita /index directamente, redirigir a la raíz limpia
RewriteCond %{THE_REQUEST} /index [NC]
RewriteRule ^(.*)index$ $1 [R=301,L]

# 3. Mapear internamente /products o /dossier a productos.html
RewriteRule ^products/?$ productos.html [NC,L]
RewriteRule ^dossier/?$ productos.html [NC,L]

# 4. Resolver cualquier archivo sin .html internamente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
